// A demo mctl plugin: reads the ApiSpec JSON on stdin and prints a routes.md file
// as the {"files":[...]} reply on stdout. Native-only — it uses async stdio to read
// its input and write its output.
import {
  "moonbitstack/moonctl",
  "moonbitlang/async",
  "moonbitlang/async/stdio",
}

supported_targets = "+native"

pkgtype(kind: "executable")
