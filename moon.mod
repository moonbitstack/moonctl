  "graphql",
  "model",
  "orm",
  "sql",
  "plugin",
  "template",
  "microservice",
  "moonapi",
  "moonzero",
  "moonbit",
  "sse",
  "event-stream",
  "subscription",
  "index",
  "foreign-key",
  "migration",
  "naming",
  "scaffold",
  "moonorm",
  "moongql",
  "moonmcp",
]

description = "Project and code generator for MoonBit services."

import {
  "moonbitlang/async@0.22.5",
  "moonbitstack/moonjson@0.4.3",
  "moonbitstack/moonyaml@0.1.4",
  "moonbitstack/moondb@0.2.7",
