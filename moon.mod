name = "moonbitstack/moonctl"

version = "0.12.6"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonctl"

license = "Apache-2.0"

keywords = [
  "goctl",
  "codegen",
  "code-generator",
  "generator",
  "scaffold",
  "scaffolding",
  "cli",
  "api",
  "dsl",
  "openapi",
  "grpc",
  "protobuf",
  "graphql",
  "model",
  "orm",
  "sql",
  "plugin",
  "template",
  "microservice",
  "moonapi",
  "moonzero",
  "moonbit",
]

description = "Project and code generator for MoonBit services."

import {
  "moonbitlang/async@0.22.5",
  "moonbitstack/moonjson@0.4.2",
  "moonbitstack/moonyaml@0.1.3",
  "moonbitstack/moondb@0.2.4",
  "moonbitstack/moonsqlite@0.3.3",
  "moonbitstack/moonpostgres@0.6.7",
}

source = "src"
