  "protobuf",
  "graphql",
  "model",
  "orm",
  "sql",
  "plugin",
  "template",
  "microservice",
  "moonapi",
  "moonzero",
  "moonbit",
  "sse",
  "event-stream",
  "gateway",
  "http",
  "rest",
  "routing",
  "subscription",
  "index",
  "foreign-key",
  "migration",
  "naming",
  "scaffold",
  "moonorm",
  "moongql",
  "moonmcp",
]

description = "Project and code generator for MoonBit services."

import {
  "moonbitlang/async@0.22.5",
  "moonbitstack/moonjson@0.5.0",
