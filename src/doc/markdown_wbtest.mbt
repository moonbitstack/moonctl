///|
/// Whether `hay` contains `needle`.
fn has(hay : String, needle : String) -> Bool {
  @text.index_of_str(hay, needle) >= 0
}

///|
test "the reference is a route table, a group table and a table per type" {
  let source =
    #|@server(group: user, prefix: /api/v1, jwt: Auth, middleware: Log)
    #|service greet {
    #|    @doc "create a user"
    #|    @handler createUser
    #|    post /users (CreateReq) returns (User)
    #|
    #|    @handler getUser
    #|    get /users/:id (GetReq) returns (User)
    #|}
    #|
    #|type GetReq {
    #|    id: int64 `path:"id"`
    #|    verbose: bool `form:"verbose,optional"`
    #|}
    #|
    #|type CreateReq {
    #|    name: string `json:"name,range=[1:40]"`
    #|}
    #|
    #|type User {
    #|    id: int64 `json:"id"`
    #|}
  let md = generate_markdown(@api.parse(source))
  assert_eq(has(md, "# greet"), true)
  assert_eq(
    has(md, "| Method | Path | Handler | Request | Response | Description |"),
    true,
  )
  assert_eq(
    has(
      md, "| POST | `/api/v1/users` | `createUser` | `CreateReq` | `User` | create a user |",
    ),
    true,
  )
  // a `:id` segment keeps its spelling in the table: this is a Markdown page, not
  // an OpenAPI document
  assert_eq(
    has(
      md, "| GET | `/api/v1/users/:id` | `getUser` | `GetReq` | `User` | — |",
    ),
    true,
  )
  assert_eq(
    has(md, "| `user` | `/api/v1` | `Auth` | `Log` | — | — |"),
    true,
  )
  assert_eq(has(md, "### GetReq"), true)
  // where a field binds, whether it is required, and what the tag constrains
  assert_eq(has(md, "| `id` | `Int64` | path | yes |  |"), true)
  assert_eq(has(md, "| `verbose` | `Bool` | query | no | optional |"), true)
  assert_eq(has(md, "| `name` | `String` | body | yes | range [1..40] |"), true)
  assert_eq(has(md, "Generated by `mctl api doc`."), true)
}

///|
test "a spec with nothing in it still documents" {
  let md = generate_markdown(
    @api.parse(
      (
        #|service greet {
        #|}
      ),
    ),
  )
  assert_eq(has(md, "_The service declares no route._"), true)
  assert_eq(has(md, "_The spec declares no type._"), true)
  assert_eq(markdown_file_name("greet"), "greet_api.md")
}
